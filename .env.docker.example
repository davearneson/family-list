# For plain Docker (without Portainer): copy this file to .env next to docker-compose.yml and fill it in.
# With Portainer, add these under the stack's "Environment variables" instead.

# The shared password everyone types once. Not case-sensitive. Changing it logs everyone out.
FAMILY_PASSWORD=

# The https address your family will use, once your tunnel is set up (see README).
PUBLIC_URL=

# Time zone used to display the reveal date.
APP_TIMEZONE=America/Chicago

# Port on this machine, if 3000 is already taken.
HOST_PORT=3000

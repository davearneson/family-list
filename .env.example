# The shared password everyone types once. Not case-sensitive. Changing it logs everyone out.
FAMILY_PASSWORD=

# Your free Turso database (see README). Locally, leave these blank to use local.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: time zone used to display the reveal date. Defaults to America/Chicago.
# APP_TIMEZONE=America/New_York
